{
  "name": "frameos",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native, API-first video editing platform",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "artifacts": "npm run artifacts --workspace @frameos/contracts",
    "analyzer:whisper-manifest": "node tools/analyzers/create-whisper-cpp-manifest.mjs",
    "analyzer:silence-manifest": "node tools/analyzers/create-ffmpeg-silence-manifest.mjs",
    "analyzer:scenes-manifest": "node tools/analyzers/create-ffmpeg-scene-manifest.mjs",
    "analyzer:beats-manifest": "node tools/analyzers/create-ffmpeg-beat-manifest.mjs",
    "bench:agent": "tsx tools/agent-benchmarks.ts",
    "build": "npm run build --workspace @frameos/contracts && npm run build --workspace @frameos/sdk && npm run build --workspace @frameos/daemon && npm run build --workspace @frameos/cli",
    "check": "npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present && npm run artifacts --workspace @frameos/contracts -- --check && npm run bench:agent && npm run sdk:python:check",
    "cli": "npm run cli --workspace @frameos/cli --",
    "dev": "npm run dev --workspace @frameos/daemon",
    "format:check": "prettier --check .",
    "mcp": "npm run mcp --workspace @frameos/daemon",
    "sbom": "node tools/generate-sbom.mjs",
    "sdk:python:check": "python -c \"import ast,pathlib; [ast.parse(pathlib.Path(p).read_text(encoding='utf-8'), filename=p) for p in ['packages/sdk-python/frameos/client.py','packages/sdk-python/frameos/__init__.py']]\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status",
    "start": "npm run start --workspace @frameos/daemon",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
