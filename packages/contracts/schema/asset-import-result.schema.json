{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/asset-import-result.json",
  "type": "object",
  "properties": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "image",
            "image_sequence",
            "subtitle",
            "font",
            "generated"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "hash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "managed": {
          "default": false,
          "type": "boolean"
        },
        "streams": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "audio",
                  "subtitle",
                  "data"
                ]
              },
              "codec": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "duration": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 65535
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 65535
              },
              "frameRate": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 768000
              },
              "channels": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 128
              },
              "metadata": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "index",
              "kind",
              "codec",
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "duration": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rate": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "value",
            "rate"
          ],
          "additionalProperties": false
        },
        "proxies": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "analysisRefs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "licenseMetadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "semanticMetadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "uri",
        "hash",
        "managed",
        "streams",
        "proxies",
        "analysisRefs",
        "licenseMetadata",
        "semanticMetadata"
      ],
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resultingRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "validate",
            "preview",
            "commit"
          ]
        },
        "draftId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "operationType": {
                "type": "string",
                "minLength": 1
              },
              "entityIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "operationId",
              "operationType",
              "entityIds",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "unavailableCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "affectedRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              },
              "duration": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "start",
              "duration"
            ],
            "additionalProperties": false
          }
        },
        "project": {}
      },
      "required": [
        "transactionId",
        "projectId",
        "baseRevision",
        "resultingRevision",
        "mode",
        "changes",
        "warnings",
        "unavailableCapabilities",
        "affectedRanges"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "cached": {
      "type": "boolean"
    }
  },
  "required": [
    "asset",
    "transaction",
    "warnings",
    "cached"
  ],
  "additionalProperties": false
}
