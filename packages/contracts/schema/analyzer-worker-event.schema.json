{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/analyzer-worker-event.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "type": {
          "type": "string",
          "const": "progress"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "type",
        "progress"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "type": {
          "type": "string",
          "const": "result"
        },
        "outputType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "segments": {
          "maxItems": 1000000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "rate": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1000000
                          },
                          "denominator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1000000
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "value",
                      "rate"
                    ],
                    "additionalProperties": false
                  },
                  "duration": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "rate": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1000000
                          },
                          "denominator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1000000
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "value",
                      "rate"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "start",
                  "duration"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "maxLength": 1000000
              },
              "labels": {
                "default": [],
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "embedding": {
                "minItems": 1,
                "maxItems": 4096,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "metadata": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "labels",
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "type",
        "outputType",
        "segments",
        "metadata"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "REVISION_CONFLICT",
            "CAPABILITY_UNAVAILABLE",
            "MEDIA_OFFLINE",
            "UNSUPPORTED_FORMAT",
            "PLUGIN_FAILURE",
            "JOB_CANCELLED",
            "RESOURCE_LIMIT",
            "INTERCHANGE_LOSS",
            "NOT_FOUND",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
