{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/analyzer-plugin-manifest.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "protocolVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,255}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "outputTypes": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "assetKinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "video",
          "audio",
          "image",
          "image_sequence",
          "subtitle",
          "font",
          "generated"
        ]
      }
    },
    "deterministic": {
      "type": "boolean"
    },
    "parameterSchema": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "executable": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arguments": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "path",
        "sha256",
        "version",
        "license",
        "arguments"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "path",
        "sha256",
        "version",
        "license"
      ],
      "additionalProperties": false
    },
    "resources": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "path",
          "sha256",
          "role",
          "license"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "default": {
        "timeoutMs": 1800000,
        "maxOutputBytes": 67108864,
        "maxSegments": 250000
      },
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 268435456
        },
        "maxSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "timeoutMs",
        "maxOutputBytes",
        "maxSegments"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "id",
    "version",
    "capabilityId",
    "name",
    "description",
    "outputTypes",
    "assetKinds",
    "deterministic",
    "parameterSchema",
    "executable",
    "resources",
    "limits",
    "metadata"
  ],
  "additionalProperties": false
}
