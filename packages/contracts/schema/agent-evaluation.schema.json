{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/agent-evaluation.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "draftId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "cycle": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 3
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "category": {
            "type": "string",
            "enum": [
              "timeline",
              "media",
              "composition",
              "captions",
              "audio",
              "continuity",
              "pacing",
              "sync",
              "capability"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail",
              "unavailable"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "entityIds": {
            "default": [],
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "ranges": {
            "default": [],
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rate": {
                      "type": "object",
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        },
                        "denominator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "value",
                    "rate"
                  ],
                  "additionalProperties": false
                },
                "duration": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rate": {
                      "type": "object",
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        },
                        "denominator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "value",
                    "rate"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "start",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "category",
          "status",
          "message",
          "entityIds",
          "ranges",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "previews": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "frame",
              "region",
              "contact_sheet",
              "waveform"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "artifactUris": {
            "maxItems": 65,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "jobId",
          "kind",
          "status",
          "artifactUris"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "runId",
    "projectId",
    "draftId",
    "cycle",
    "passed",
    "checks",
    "previews",
    "createdAt"
  ],
  "additionalProperties": false
}
