{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/transaction-result.json",
  "type": "object",
  "properties": {
    "transactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resultingRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "validate",
        "preview",
        "commit"
      ]
    },
    "draftId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "operationType": {
            "type": "string",
            "minLength": 1
          },
          "entityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "operationId",
          "operationType",
          "entityIds",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "unavailableCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "affectedRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rate": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "value",
              "rate"
            ],
            "additionalProperties": false
          },
          "duration": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rate": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "value",
              "rate"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "start",
          "duration"
        ],
        "additionalProperties": false
      }
    },
    "project": {}
  },
  "required": [
    "transactionId",
    "projectId",
    "baseRevision",
    "resultingRevision",
    "mode",
    "changes",
    "warnings",
    "unavailableCapabilities",
    "affectedRanges"
  ],
  "additionalProperties": false
}
