{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/agent-session.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai-compatible",
        "anthropic",
        "gemini",
        "local",
        "external"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approvalMode": {
      "type": "string",
      "enum": [
        "propose",
        "supervised",
        "autonomous"
      ]
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxOperationsPerTransaction": {
          "default": 200,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "maxPreviewCycles": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxAffectedDurationFrames": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxProviderCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxRenderSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxOperationsPerTransaction",
        "maxPreviewCycles"
      ],
      "additionalProperties": false
    },
    "allowedOperationFamilies": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "projectId",
    "provider",
    "model",
    "approvalMode",
    "budgets",
    "allowedOperationFamilies",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
