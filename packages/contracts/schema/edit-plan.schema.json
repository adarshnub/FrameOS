{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/edit-plan.json",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "assumptions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "clarificationRequired": {
      "type": "boolean"
    },
    "clarificationQuestion": {
      "type": "string",
      "maxLength": 8192
    },
    "steps": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "operationFamilies": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "expectedAffectedRanges": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rate": {
                      "type": "object",
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        },
                        "denominator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "value",
                    "rate"
                  ],
                  "additionalProperties": false
                },
                "duration": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rate": {
                      "type": "object",
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        },
                        "denominator": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "value",
                    "rate"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "start",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "frame",
                "contact_sheet",
                "region",
                "waveform",
                "timeline_invariants"
              ]
            }
          }
        },
        "required": [
          "id",
          "description",
          "operationFamilies",
          "expectedAffectedRanges",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    }
  },
  "required": [
    "goal",
    "summary",
    "assumptions",
    "clarificationRequired",
    "steps",
    "warnings"
  ],
  "additionalProperties": false
}
