{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/semantic-find-result.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "speaker",
        "quote",
        "scene",
        "object",
        "silence",
        "best_take"
      ]
    },
    "query": {
      "type": "string",
      "maxLength": 8192
    },
    "matches": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lexicalScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "semanticScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              },
              "duration": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "start",
              "duration"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "maxLength": 1000000
          },
          "labels": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "speaker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "segmentId",
          "artifactId",
          "assetId",
          "type",
          "score",
          "labels",
          "metadata"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "query",
    "matches"
  ],
  "additionalProperties": false
}
