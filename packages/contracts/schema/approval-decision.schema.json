{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/approval-decision.json",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "decidedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "note": {
      "type": "string",
      "maxLength": 8192
    }
  },
  "required": [
    "decision",
    "decidedBy"
  ],
  "additionalProperties": false
}
