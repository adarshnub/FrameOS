{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/analyzer-worker-request.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "analyzerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "analyzerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "image",
            "image_sequence",
            "subtitle",
            "font",
            "generated"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "hash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "audio",
                  "subtitle",
                  "data"
                ]
              },
              "codec": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "duration": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "value",
                  "rate"
                ],
                "additionalProperties": false
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 65535
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 65535
              },
              "frameRate": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 768000
              },
              "channels": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 128
              },
              "metadata": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "index",
              "kind",
              "codec",
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "duration": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rate": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "value",
            "rate"
          ],
          "additionalProperties": false
        },
        "semanticMetadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "path",
        "hash",
        "streams",
        "semanticMetadata"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "modelPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "resources": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "analyzerId",
    "analyzerVersion",
    "asset",
    "parameters",
    "resources"
  ],
  "additionalProperties": false
}
