{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/preview-artifact.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "frame",
        "region",
        "contact_sheet",
        "waveform"
      ]
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2160
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rate": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "value",
            "rate"
          ],
          "additionalProperties": false
        },
        "duration": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rate": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "value",
            "rate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "start",
        "duration"
      ],
      "additionalProperties": false
    },
    "entries": {
      "minItems": 1,
      "maxItems": 65,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "mimeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "at": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rate": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "value",
              "rate"
            ],
            "additionalProperties": false
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "uri",
          "mimeType",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "provenanceUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  },
  "required": [
    "kind",
    "width",
    "height",
    "entries",
    "provenanceUri"
  ],
  "additionalProperties": false
}
