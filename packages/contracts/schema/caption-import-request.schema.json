{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/caption-import-request.json",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequenceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "mode": {
      "default": "commit",
      "type": "string",
      "enum": [
        "validate",
        "preview",
        "commit"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "srt",
        "vtt"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4194304
    },
    "trackId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "default": "Imported captions",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "language": {
      "default": "und",
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "style": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "projectId",
    "sequenceId",
    "baseRevision",
    "idempotencyKey",
    "mode",
    "format",
    "content",
    "name",
    "language",
    "enabled",
    "style"
  ],
  "additionalProperties": false
}
