{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameos.dev/schema/v1/agent-run.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "state": {
      "type": "string",
      "enum": [
        "interpreting",
        "planning",
        "awaiting_clarification",
        "planned",
        "validating",
        "previewing",
        "evaluating",
        "awaiting_approval",
        "committing",
        "rendering",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "assumptions": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "clarificationRequired": {
          "type": "boolean"
        },
        "clarificationQuestion": {
          "type": "string",
          "maxLength": 8192
        },
        "steps": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "operationFamilies": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "expectedAffectedRanges": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rate": {
                          "type": "object",
                          "properties": {
                            "numerator": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 1000000
                            },
                            "denominator": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 1000000
                            }
                          },
                          "required": [
                            "numerator",
                            "denominator"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "value",
                        "rate"
                      ],
                      "additionalProperties": false
                    },
                    "duration": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rate": {
                          "type": "object",
                          "properties": {
                            "numerator": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 1000000
                            },
                            "denominator": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 1000000
                            }
                          },
                          "required": [
                            "numerator",
                            "denominator"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "value",
                        "rate"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "start",
                    "duration"
                  ],
                  "additionalProperties": false
                }
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "frame",
                    "contact_sheet",
                    "region",
                    "waveform",
                    "timeline_invariants"
                  ]
                }
              }
            },
            "required": [
              "id",
              "description",
              "operationFamilies",
              "expectedAffectedRanges",
              "verification"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "required": [
        "goal",
        "summary",
        "assumptions",
        "clarificationRequired",
        "steps",
        "warnings"
      ],
      "additionalProperties": false
    },
    "providerResponseId": {
      "type": "string",
      "maxLength": 512
    },
    "draftId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "transactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "approvalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "resultingRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previewCycles": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "sessionId",
    "projectId",
    "projectRevision",
    "request",
    "state",
    "previewCycles",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
