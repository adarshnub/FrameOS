# FrameOS automatically loads FRAMEOS_* values from this file on startup.
# Existing shell/process variables take precedence.
FRAMEOS_OPENAI_API_KEY=replace-with-a-new-revocable-server-side-key
FRAMEOS_OPENAI_MODEL=gpt-4.1-mini

# Register multiple models in the admin control room if needed:
# FRAMEOS_OPENAI_MODELS=gpt-4.1-mini,gpt-4.1-nano
# FRAMEOS_OPENAI_BASE_URL=https://api.openai.com/v1
