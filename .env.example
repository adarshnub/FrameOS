# FrameOS automatically loads FRAMEOS_* values from this file on startup.
# Existing shell/process variables take precedence.
FRAMEOS_OPENAI_API_KEY=replace-with-a-new-revocable-server-side-key
FRAMEOS_OPENAI_MODEL=gpt-4.1-mini

# Register multiple models in the admin control room if needed:
# FRAMEOS_OPENAI_MODELS=gpt-4.1-mini,gpt-4.1-nano
# FRAMEOS_OPENAI_BASE_URL=https://api.openai.com/v1

# Database migration target. Local Supabase starts Postgres at the URL shown by
# `npm run supabase:status`; hosted Supabase should use a server-only pooled URL.
# The current daemon still uses its SQLite runtime store while the Postgres
# adapter is completed; never expose this URL to the browser.
# FRAMEOS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Gemini through Vertex AI. Use Application Default Credentials (ADC) locally
# with service-account impersonation; do not store service-account JSON keys.
# FRAMEOS_GEMINI_PROVIDER=vertex-ai
# FRAMEOS_GCP_AUTH_MODE=adc
# FRAMEOS_GCLOUD_COMMAND=path-to-gcloud-or-gcloud.cmd-on-local-Windows
# FRAMEOS_GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# FRAMEOS_GOOGLE_CLOUD_LOCATION=global
# FRAMEOS_GEMINI_MODEL=gemini-2.5-flash
# FRAMEOS_GEMINI_FRAME_MODEL=gemini-2.5-flash-lite
# FRAMEOS_GCS_BUCKET=your-private-frameos-media-bucket
# FRAMEOS_GEMINI_MEDIA_RESOLUTION=low
# FRAMEOS_GEMINI_MAX_VIDEO_SECONDS=1800
# FRAMEOS_GEMINI_MAX_COST_USD_PER_ANALYSIS=0.10
# FRAMEOS_GEMINI_TIMEOUT_MS=120000
# FRAMEOS_GEMINI_DELETE_REMOTE_MEDIA=true
# Prices are overridable safeguards for FrameOS cost estimates, not billing data.
# FRAMEOS_GEMINI_INPUT_USD_PER_MILLION=0.15
# FRAMEOS_GEMINI_OUTPUT_USD_PER_MILLION=0.60
# FRAMEOS_GEMINI_INPUT_TOKENS_PER_SECOND=283
